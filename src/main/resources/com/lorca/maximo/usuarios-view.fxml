<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="516.0" prefWidth="835.0" spacing="20.0" style="-fx-background-color: navy blue;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lorca.maximo.controller.UsuariosController">
    <Label style="-fx-font-size: 18px" text="Gestión de Usuarios" textFill="WHITE" />

    <HBox alignment="CENTER" spacing="10">
        <TextField fx:id="txtId" disable="true" prefWidth="40" promptText="Id" />
        <TextField fx:id="txtNombre" prefHeight="25.0" prefWidth="119.0" promptText="Nombre de usuario" />
        <TextField fx:id="txtContrasena" prefWidth="100" promptText="Contraseña" />
        <TextField fx:id="txtCorreo" prefWidth="100" promptText="Correo" />
        <TextField fx:id="txtEdad" prefHeight="25.0" prefWidth="67.0" promptText="Edad" />
        <Button fx:id="btnAgregar" defaultButton="true" onAction="#handleAgregarUsuario" text="Agregar" />
        <Button fx:id="btnEliminar" disable="true" onAction="#handleEliminarUsuario" style="-fx-background-color: salmon red;" text="Eliminar" />
        <Button fx:id="btnActualizar" onAction="#handleActualizarTabla" text="Actualizar" />
        <Button onAction="#onGuardar" style="-fx-background-color: green;" text="Guardar" />
        <Button onAction="#onLeer" text="Leer" />
    </HBox>

    <TableView fx:id="tableUsuarios" onMouseClicked="#handleSeleccionar" prefHeight="411.0" prefWidth="732.0">
        <columns>
            <TableColumn fx:id="colId" text="ID" />
            <TableColumn fx:id="colNombre" text="Nombre" />
            <TableColumn fx:id="colContrasena" prefWidth="102.0" text="Contraseña" />
            <TableColumn fx:id="colCorreo" prefWidth="77.0" text="Correo" />
            <TableColumn fx:id="colEdad" prefWidth="61.0" text="Edad" />
            <TableColumn fx:id="colFechaCreacion" prefWidth="130.0" text="Fecha Creación" /> 
        </columns>
    </TableView>
</VBox>
